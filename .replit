modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "timezone-backup-regressions"

[[workflows.workflow]]
name = "timezone-backup-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "TZ=UTC pnpm test && TZ=America/Los_Angeles pnpm test && TZ=Pacific/Kiritimati pnpm test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
